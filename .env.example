# Clé Groq (gratuite) — créer sur https://console.groq.com/keys
GROQ_API_KEY=

# Clé Gemini (fallback gratuit) — créer sur https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Port serveur
PORT=3000

# Voix Edge TTS (français)
# Femme : fr-FR-DeniseNeural (chaleureuse), fr-FR-EloiseNeural (jeune), fr-FR-VivienneMultilingualNeural (multilingue)
# Homme : fr-FR-HenriNeural (posé), fr-FR-RemyMultilingualNeural (multilingue)
TTS_VOICE=fr-FR-DeniseNeural
